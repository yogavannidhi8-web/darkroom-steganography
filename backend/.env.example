# DARKROOM / Image Security Lab - Backend Production Configuration
# Copy this file to .env and adjust values for your environment.
# Zero external/AI API keys required. Local deterministic cryptographic libraries only.

# Environment: "development" or "production"
APP_ENV=production

# Allowed CORS Origins (comma-separated list of allowed frontend domains)
# In production, set this to your deployed frontend URL (e.g. https://darkroom-frontend.onrender.com)
ALLOWED_ORIGINS=https://darkroom-frontend.onrender.com,http://localhost:5173,http://localhost:3000

# File Upload Limits
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=8000000

# Server Listening Port (Default: 8000, Render injects PORT dynamically)
PORT=8000
