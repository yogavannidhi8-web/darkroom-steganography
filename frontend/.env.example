# DARKROOM / Image Security Lab - Frontend Production Configuration
# Copy this file to .env and adjust values for your environment.

# Production Backend API URL
# Leave empty in local development to use the Vite proxy (/api -> http://localhost:8000).
# In production, set to your deployed backend HTTPS URL (e.g. https://darkroom-backend.onrender.com).
VITE_API_BASE_URL=
